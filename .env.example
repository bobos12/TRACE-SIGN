# ─────────────────────────────────────────────────────────────
# TRACE.SIGN environment
# Copy to .env (local) or set in your host's environment settings.
# Mailbox credentials are NOT set here — enter them in
# Admin → Email Integration, where they are stored encrypted.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Supabase, Neon, Railway, or your own server)
DATABASE_URL="postgresql://user:password@localhost:5432/trace_sign?schema=public"

# Public base URL of THIS TRACE.SIGN deployment. Every signing,
# download and logo link in emails is built from this value only
# (never from request headers). Must be https in production.
APP_URL="https://sign.trace-studio.tech"

# 32-byte key, base64. Encrypts SMTP/IMAP passwords at rest.
# Generate: npm run gen:key   — keep it secret, back it up.
# Losing it means re-entering mailbox passwords.
SETTINGS_ENCRYPTION_KEY=""

# Signs admin sessions and recipient signing links. Generate
# another value with: npm run gen:key
SESSION_SECRET=""

# Administrator login
ADMIN_EMAIL="admin@trace-studio.tech"
# scrypt hash — generate with: npm run hash-password
ADMIN_PASSWORD_HASH=""

# Protects /api/cron/tick (queue, reminders, expiry, IMAP sync).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Optional: shared secret for /api/webhooks/email-status
# (only if a future relay/provider can POST delivered/bounced events)
EMAIL_WEBHOOK_SECRET=""
