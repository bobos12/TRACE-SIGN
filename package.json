    "db:generate": "drizzle-kit generate",
    "test:e2e": "tsx scripts/e2e-local.ts",
    "mail:dev": "tsx scripts/dev-mail.ts",
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "predev": "node scripts/copy-pdfjs.mjs",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "test:workflow": "tsx scripts/e2e-workflow.ts",
    "test:browser": "tsx scripts/e2e-browser.ts",
    "test": "tsx scripts/e2e-workflow.ts && tsx scripts/e2e-local.ts"
